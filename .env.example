# ---------------------------------------------------------------------------
# Copy to .env and edit. Everything below has a working default except keys.
# Leave LLM_PROVIDER=demo to run the whole system with no API key at all.
# ---------------------------------------------------------------------------

# demo | anthropic | openai
LLM_PROVIDER=demo

# --- Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- OpenAI / OpenRouter / DeepSeek / Ollama (OpenAI-compatible) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# --- Branding ---
COMPANY_NAME=Northwind Coffee Co.
AGENT_NAME=Nora

# --- Behaviour ---
TOP_K=4
HANDOFF_SCORE=60

# --- n8n hand-off (Webhook node URL) ---
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# --- Infra ---
ADMIN_TOKEN=demo-admin-token
HOST=127.0.0.1
PORT=8000

# Fill an empty database with sample traffic at startup. Use on free hosting
# tiers that have no persistent disk, so the dashboard is never blank.
SEED_ON_START=false
